msgid "The endpoint answers and the Authorization header reaches WordPress."
msgstr "El endpoint responde y la cabecera Authorization llega a WordPress."

#: includes/admin/class-diagnostics.php:63
msgid "Authorization header"
msgstr "Cabecera Authorization"

#: includes/admin/class-diagnostics.php:63
msgid "Your server removes the Authorization header. Add this line to .htaccess, above the WordPress block: SetEnvIf Authorization \"(.*)\" HTTP_AUTHORIZATION=$1 — or configure your client to send the key in the X-MCPress-Key header."
msgstr "Tu servidor elimina la cabecera Authorization. Agrega esta línea al .htaccess, encima del bloque de WordPress: SetEnvIf Authorization \"(.*)\" HTTP_AUTHORIZATION=$1 — o configura tu cliente para enviar la clave en la cabecera X-MCPress-Key."

#. translators: %d: HTTP status.
#: includes/admin/class-diagnostics.php:65
#, php-format
msgid "Unexpected HTTP %d from the MCP endpoint. A security plugin or firewall may be blocking the REST API."
msgstr "HTTP %d inesperado del endpoint MCP. Puede que un plugin de seguridad o un firewall esté bloqueando la API REST."

